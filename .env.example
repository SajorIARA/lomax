AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://floci:4566

FLOCI_IMAGE=floci/floci:latest
FLOCI_STORAGE_MODE=persistent
FLOCI_STORAGE_PERSISTENT_PATH=/app/data

RDS_DB=lomax
RDS_USER=lomax
RDS_PASSWORD=lomax123
RDS_INSTANCE=lomax-postgres
# Puerto proxy RDS asignado por Floci (rango 7001-7099). Se descubre con describe-db-instances.
RDS_PORT=7001
DATABASE_URL=postgresql://lomax:lomax123@floci:7001/lomax

DYNAMO_TABLE=lomax-atributos
S3_ORIGINALES=lomax-originales
S3_MINIATURAS=lomax-miniaturas
LAMBDA_THUMB=lomax-thumbnail

BACKEND_PORT=3000
FRONTEND_PORT=80
PROXY_HOST_PORT=8080

ECR_BACKEND=lomax-backend
ECR_FRONTEND=lomax-frontend
IMAGE_TAG=latest
